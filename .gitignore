
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Local-only
.claude/settings.local.json
.DS_Store

# Build outputs and spike test data (never commit vault data)
/dist/
/bin/
/build/
# Secure Enclave key blobs (only usable on the Mac that made them; never commit)
*.blob
spikes/**/build/
spikes/**/testvault/

# Private planning docs (personal paths, vault names) - local only
docs/private/

# Vault data must never be committed (tests generate their own at runtime)
*.age
**/vault.json
**/index.json
/requests/

# Go
/coverage.out
*.test
